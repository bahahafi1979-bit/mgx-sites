---
export async function getStaticPaths() { const files = import.meta.glob('../../data/sites/*.json', { eager: true }); return Object.entries(files).map(([p, m]) => ({ params: { id: p.split('/').pop().replace('.json', '') }, props: { siteData: m.default } })); }
const { siteData } = Astro.props;

const site = siteData.site;
const name = site.name || 'اسم المحل';
const description = site.description || 'مرحباً بكم في موقعنا الإلكتروني';
const language = site.language || 'ar';
const direction = ['ar', 'fa', 'ur', 'he'].includes(language) ? 'rtl' : 'ltr';
const images = Array.isArray(site.images) ? site.images : [];const content = (site.content || '').replaceAll('**', '').replaceAll('*', '');
const t = String(site.type || '').toLowerCase(); const color = [['restaurant|food|مطعم|essen|imbiss|café|cafe|كافيه|قهوة|restoran','#8b2e16'],['friseur|hair|حلاق|صالون|barber|beauty|تجميل|kuaför','#6b2d5c'],['auto|car|سيارات|kfz|werkstatt|oto','#1f3a5f'],['bäck|bakery|مخبز|حلويات|fırın','#a0642b'],['shop|markt|supermarket|سوبر|بقالة|laden|market','#1d6b45']].find(([k]) => new RegExp(k).test(t))?.[1] || '#14283f';
---

<!doctype html>
<html lang={language} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{name}</title>
   <style define:vars={{ color }}>
      :root { font-family: system-ui, sans-serif; color: #182433; background: #f7f9fc; }
      body { margin: 0; }
      header { background:var(--color); color: white; padding: 4rem 1.5rem; text-align: center; }
      main { max-width: 1000px; margin: auto; padding: 2rem 1.5rem; }
     section { margin-bottom: 2.5rem; white-space: pre-wrap; }
      h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
      p { line-height: 1.8; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
      img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 12px; }
      footer { text-align: center; padding: 2rem; background: #e8edf3; }
    </style>
  </head>
  <body>
    <header>
      <h1>{name}</h1>
     <p>{language === 'ar' ? description : language === 'de' ? 'Willkommen auf unserer Website' : 'Welcome to our website'}</p>
    </header>
    <main>
      <section>
        <h2>{language === 'ar' ? 'من نحن' : ({de:'Über uns',tr:'Hakkımızda'}[language] || 'About us')}</h2>
    {content || description}
      </section>
      {images.length > 0 && (
        <section>
          <h2>{language === 'ar' ? 'معرض الصور' : ({de:'Galerie',tr:'Galeri'}[language] || 'Gallery')}</h2>
          <div class="gallery">
            {images.map((image) => <img src={image} alt={name} loading="lazy" />)}
          </div>
        </section>
      )}
      <section>
        <h2>{language === 'ar' ? 'تواصل معنا' : ({de:'Kontakt',tr:'İletişim'}[language] || 'Contact')}</h2>
       {site.phone && <p><a href={'tel:' + site.phone} style="display:inline-block;padding:1rem 2rem;margin:.5rem;background:#14283f;color:#fff;border-radius:12px;text-decoration:none;font-size:1.2rem">📞 {site.phone}</a><a href={'https://wa.me/' + (() => { const d = String(site.phone).replace(/\D/g, ''); const cc = {EUR:'49',JOD:'962',SAR:'966',AED:'971',EGP:'20',TRY:'90'}[site.currency] || '49'; return d.startsWith('00') ? d.slice(2) : d.startsWith('0') ? cc + d.slice(1) : d; })()} style="display:inline-block;padding:1rem 2rem;margin:.5rem;background:#25D366;color:#fff;border-radius:12px;text-decoration:none;font-size:1.2rem">WhatsApp</a></p>}
        {site.address && <p>{site.address}</p>}
{site.address && <iframe src={'https://www.google.com/maps?q=' + encodeURIComponent(site.address) + '&output=embed'} style="width:100%;height:300px;border:0;border-radius:12px;margin-top:1rem" loading="lazy"></iframe>}
      </section>
    </main>
    <footer>© {new Date().getFullYear()} {name}</footer>
  </body>
</html>
