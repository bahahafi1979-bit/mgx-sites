---
import siteData from '../../data/site.json';

const site = siteData.site;
const name = site.name || 'اسم المحل';
const description = site.description || 'مرحباً بكم في موقعنا الإلكتروني';
const language = site.language || 'ar';
const direction = ['ar', 'fa', 'ur', 'he'].includes(language) ? 'rtl' : 'ltr';
const images = Array.isArray(site.images) ? site.images : [];const content = (site.content || '').replaceAll('**', '').replaceAll('*', '');
---

<!doctype html>
<html lang={language} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{name}</title>
    <style>
      :root { font-family: system-ui, sans-serif; color: #182433; background: #f7f9fc; }
      body { margin: 0; }
      header { background: #14283f; color: white; padding: 4rem 1.5rem; text-align: center; }
      main { max-width: 1000px; margin: auto; padding: 2rem 1.5rem; }
     section { margin-bottom: 2.5rem; white-space: pre-wrap; }
      h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
      p { line-height: 1.8; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
      img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 12px; }
      footer { text-align: center; padding: 2rem; background: #e8edf3; }
    </style>
  </head>
  <body>
    <header>
      <h1>{name}</h1>
     <p>{language === 'ar' ? description : language === 'de' ? 'Willkommen auf unserer Website' : 'Welcome to our website'}</p>
    </header>
    <main>
      <section>
        <h2>{language === 'ar' ? 'من نحن' : ({de:'Über uns',tr:'Hakkımızda'}[language] || 'About us')}</h2>
    {content || description}
      </section>
      {images.length > 0 && (
        <section>
          <h2>{language === 'ar' ? 'معرض الصور' : ({de:'Galerie',tr:'Galeri'}[language] || 'Gallery')}</h2>
          <div class="gallery">
            {images.map((image) => <img src={image} alt={name} loading="lazy" />)}
          </div>
        </section>
      )}
      <section>
        <h2>{language === 'ar' ? 'تواصل معنا' : ({de:'Kontakt',tr:'İletişim'}[language] || 'Contact')}</h2>
        {site.phone && <p>{site.phone}</p>}
        {site.address && <p>{site.address}</p>}
      </section>
    </main>
    <footer>© {new Date().getFullYear()} {name}</footer>
  </body>
</html>
